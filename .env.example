# Project DELTA environment template.
# Local development: copy to server/.env
# Vercel: set these in Project Settings -> Environment Variables

# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local dashboard server port (local dev only)
PORT=8000

# Face recognition threshold: max Euclidean distance between two
# face-api.js 128-d descriptors to accept a match (default 0.6).
# Lower = stricter. Optional.
FACE_MATCH_THRESHOLD=0.6
